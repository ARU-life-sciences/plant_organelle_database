reports/
config/paths.env
.venv/
__pycache__/
*.pyc
*.log

# analysis/ scratch intermediates (temp blast dbs, work-in-progress files) -
# only final results/ tables, PAFs, alignments, and trees are tracked.
analysis/*/work/
analysis/common/.cache/

# samtools faidx index files, created as a side effect of annotation/orf_scan
# reading data/*.ctg.fasta - trivially regenerable, not worth committing.
data/**/*.fasta.fai

# IQ-TREE internal byproducts with no value once a run has completed
# successfully: .ckp.gz only supports resuming an interrupted run,
# .uniqueseq.phy is a deduplicated-alignment scratch file redundant with
# the alignments already kept under phylogeny/results/alignments|concat/.
analysis/phylogeny/results/trees/*.ckp.gz
analysis/phylogeny/results/trees/*.uniqueseq.phy

# rev/out/ holds raw oatk rerun outputs from src/07_revision_submit_oatk_from_list.sh -
# scratch by design. src/09_promote_revision.py compares each rerun against data/ and
# copies in only the ones that are objectively better; the rest (and every rerun before
# promotion) stay here untracked. Was previously excluded via ~60 hardcoded per-file
# paths, which silently stopped covering new reruns - a plain directory ignore doesn't
# have that failure mode.
rev/out/

/logs
/rev/logs
analysis/linearize/logs/
analysis/denovo_annotation/logs/

# Raw unitig sequences - a straight copy of each GFA's S lines (441MB at
# full scale), regenerated in seconds by unitig_coords/src/00_build_unitig_map.py.
analysis/unitig_coords/results/unitig_fasta/
